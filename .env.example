# Copy this file to .env and fill in your Jenkins credentials.
# .env is git-ignored and will never be committed.

JENKINS_URL=http://localhost:8080
JENKINS_USER=your-username
JENKINS_TOKEN=your-api-token

# Local mode: custom Docker image (optional, defaults to ghcr.io/jenkinsci/jenkinsfilelint-server:latest)
# JENKINSFILELINT_SERVER_IMAGE=my-registry/jenkinsfilelint-server:custom
